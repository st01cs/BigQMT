# ============================================================
# BigQMT - 原生QMT配置示例
# 复制为 .env 后填写；所有项均可选，缺失项由自动发现兜底
# ============================================================

# 原生QMT（完整版客户端）可执行文件完整路径
# 示例：D:\国金QMT交易端模拟\bin.x64\XtItClient.exe
# QMT_EXE_PATH=

# xtquant 连接必需的数据目录（userdata_mini 或 userdata 所在目录）
# 示例：D:\国金QMT交易端模拟\userdata_mini
# QMT_USERDATA_PATH=
# QMT_DATA_DIR=            # 与 QMT_USERDATA_PATH 二选一的别名

# 交易账户 ID（登录后可在客户端 交易 → 资金账户 查看；实盘下单必需）
# QMT_ACCOUNT_ID=

# 登录密码（自动登录使用；留空则等待人工登录）
# QMT_PASSWORD=

# 自动登录依赖：pip install bigqmt[auto_login]（pywinauto/pyautogui）

# 会话 ID：多个进程同时连接时需唯一；留空由程序自动生成
# QMT_SESSION_ID=

# 进程名白名单（进程检测/重启用，逗号分隔；默认 XtItClient.exe）
# QMT_PROCESS_NAMES=XtItClient.exe

# 行为开关
# QMT_AUTO_START=true
# QMT_AUTO_RESTART=true
# QMT_TRADING_REQUIRED=false   # true=READY 还需交易通道(XtQuantTrader,P4)；false=仅需登录+数据
# QMT_MAX_RESTARTS=3
# QMT_POLL_INTERVAL=20
# QMT_LOGIN_TIMEOUT=60
# QMT_MANUAL_LOGIN_WAIT=120
