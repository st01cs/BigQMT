# ============================================================
# BigQMT - 原生QMT配置示例
# 复制为 .env 后填写；所有项均可选，缺失项由自动发现兜底
# ============================================================

# 原生QMT（完整版客户端）可执行文件完整路径
# 示例：D:\国金QMT交易端模拟\bin.x64\XtItClient.exe
# QMT_EXE_PATH=

# xtquant 连接必需的数据目录（userdata_mini 或 userdata 所在目录）
# 示例：D:\国金QMT交易端模拟\userdata_mini
# QMT_USERDATA_PATH=
# QMT_DATA_DIR=            # 与 QMT_USERDATA_PATH 二选一的别名

# 交易账户 ID（登录后可在客户端 交易 → 资金账户 查看；实盘下单必需）
# QMT_ACCOUNT_ID=

# 登录密码（自动登录使用；留空则等待人工登录）
# QMT_PASSWORD=

# 自动登录依赖：pip install bigqmt[auto_login]（pywinauto/pyautogui）

# 会话 ID：多个进程同时连接时需唯一；留空由程序自动生成
# QMT_SESSION_ID=

# 进程名白名单（进程检测/重启用，逗号分隔；默认 XtItClient.exe）
# QMT_PROCESS_NAMES=XtItClient.exe

# 行为开关
# QMT_AUTO_START=true
# QMT_AUTO_RESTART=true
# QMT_TRADING_REQUIRED=false   # true=READY 还需交易通道(XtQuantTrader,P4)；false=仅需登录+数据
# QMT_MAX_RESTARTS=3
# QMT_POLL_INTERVAL=20
# QMT_LOGIN_TIMEOUT=60
# QMT_MANUAL_LOGIN_WAIT=120

# ============================================================
# 策略自动运行（QMT READY 后自动拉起指定策略；见 docs/QMT_STRATEGY_RUNNER_PLAN.md）
# ============================================================

# 启用策略自动运行
# QMT_STRATEGY_ENABLED=false

# 策略命令行（完整命令；首 token 为裸 python/python.exe 时替换为 QMT_STRATEGY_PYTHON
# 或当前解释器）。示例：python D:\strat\main.py --trade
# QMT_STRATEGY_CMD=

# 策略解释器（需可 import xtquant；默认 sys.executable）
# QMT_STRATEGY_PYTHON=

# 策略工作目录
# QMT_STRATEGY_CWD=

# 运行模式：once（退出即结束）| supervise（崩溃自动重启，默认）
# QMT_STRATEGY_MODE=supervise

# supervise 模式下崩溃自动重启上限
# QMT_STRATEGY_MAX_RESTARTS=3

# 策略日志路径（默认 <cwd>\logs\strategy_<时间戳>.log）
# QMT_STRATEGY_LOG=

# 启动确认超时（秒，仅 supervise 模式）
# QMT_STRATEGY_START_TIMEOUT=30

# 停止宽限（秒，超时后强杀）
# QMT_STRATEGY_GRACE=10

# ===================================
# MCP 服务（bigqmt.mcp，详见 docs/QMT_MCP_SERVER_PLAN.md）
# ===================================

# MCP 监听地址（默认仅本机 127.0.0.1；填 0.0.0.0 必须同时开启 QMT_MCP_ALLOW_REMOTE）
# QMT_MCP_HOST=127.0.0.1

# MCP 监听端口
# QMT_MCP_PORT=9000

# 允许绑定非回环地址（对局域网开放，建议同时设置 QMT_MCP_AUTH_TOKEN）
# QMT_MCP_ALLOW_REMOTE=0

# 非空则 MCP 入口要求 Authorization: Bearer <token>
# QMT_MCP_AUTH_TOKEN=

# QMT 侧 HTTP API 地址与 Token（须与 bigqmt/service/http.py 内的 TOKEN 一致）
# QMT_HTTP_BASE_URL=http://127.0.0.1:10086
# QMT_HTTP_TOKEN=123456789

# 调用 QMT 后端的超时（秒）
# QMT_MCP_REQUEST_TIMEOUT=10
